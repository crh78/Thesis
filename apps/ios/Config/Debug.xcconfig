// Debug build settings.
//
// Backend values (Privy app/client ID, Supabase URL and publishable key): Backend.local.xcconfig
// and Privy.local.xcconfig, gitignored; copy their .example files. Without them the app still
// builds, and stops at launch naming the missing value.
#include? "Backend.local.xcconfig"
#include? "Privy.local.xcconfig"

// Dev login (welcome screen → "Dev login"): a username/password that signs in to
// the Privy test account. Values live in DevLogin.local.xcconfig, which is
// gitignored; copy DevLogin.local.xcconfig.example to create it. Without the
// file the Dev login link just doesn't appear.
#include? "DevLogin.local.xcconfig"

// The fork API (cash, trades, posting and receipts on the shared mainnet fork): FORK_API_URL in
// Fork.local.xcconfig, also gitignored; copy Fork.local.xcconfig.example. Required: without it
// the app still builds, and stops at launch saying FORK_API_URL is missing.
#include? "Fork.local.xcconfig"
