# X app (developer.x.com → your app → Keys and tokens), with Read and Write permission.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# The bot account's (@yourthesisxyz) access token and secret: "Generate" under Authentication
# Tokens while signed in as the bot, after setting the app to Read and Write.
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 1 = log the reply instead of posting it (drafts are still made). Start here.
X_DRY_RUN=1
# Optional: X_POLL_SECONDS (30), X_MAX_REPLIES_PER_DAY (100), X_MAX_PER_AUTHOR (10 a day),
# X_MAX_PER_THREAD (3 a day), X_STATE_FILE (apps/x/.data/state.json).
# X_UNLIMITED: X usernames with no reply caps (comma-separated, e.g. the team's own accounts).

# The vetting model (OpenAI Responses, low effort). OPENAI_AGENT_MODEL defaults to gpt-6-luna.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=

# Same as apps/imessage/.env: drafts (they run the take builder) and the web app.
SUPABASE_URL=https://<project-ref>.supabase.co
# The Vault's bot_secret: select decrypted_secret from vault.decrypted_secrets where name = 'bot_secret';
THESIS_BOT_SECRET=
WEB_URL=
