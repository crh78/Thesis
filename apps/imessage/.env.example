# Which transport: sendblue (default) or bluebubbles (free, works in group chats).
IMESSAGE_PROVIDER=

# BlueBubbles (IMESSAGE_PROVIDER=bluebubbles): the server on the bot's Mac and its password.
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=

# Sendblue (iMessage). `npx @sendblue/cli show-keys` prints the key + secret;
# `npx @sendblue/cli lines` shows your number. Never commit the real values.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# Our Sendblue line, E.164 (free plan: the shared number)
SENDBLUE_FROM_NUMBER=

# Agent (@thesis/agent): OpenAI Responses API, Luna at low reasoning effort.
OPENAI_API_KEY=
# Optional, default gpt-6-luna
OPENAI_AGENT_MODEL=

# Baskets: the source function's POST /drafts runs the take builder and saves a draft take.
SUPABASE_URL=https://<project-ref>.supabase.co
# The bots' key for it: the Vault's bot_secret.
#   select decrypted_secret from vault.decrypted_secrets where name = 'bot_secret';
THESIS_BOT_SECRET=
# Where a draft's page lives (/d/<id>). Default https://thesis-www.vercel.app
WEB_URL=
