# Settings for @thesis/www. Copy to .env.local (gitignored) and fill in; in Vercel, set them as
# project environment variables. See README.md → Settings.

# Required, client. Inlined at build time, so set them before `next build`.
NEXT_PUBLIC_PRIVY_APP_ID=<privy-app-id>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# Required, server only.
FORK_API_URL=https://<fork-host>
FORK_API_PROXY_KEY=<shared-secret-with-the-fork-api>

# Optional, server only: the fork Blink. Without it /actions.json and /api/actions/* don't exist.
FORK_BLINK_URL=https://<fork-host>:8443

# Optional.
# NEXT_PUBLIC_X_LOGIN=on
# NEXT_PUBLIC_SITE_URL=https://<your-domain>
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
