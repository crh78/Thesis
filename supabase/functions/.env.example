# Edge function secrets. Copy to supabase/functions/.env for `supabase functions serve`,
# and push to the hosted project with: supabase secrets set --env-file supabase/functions/.env
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Privy Dashboard → Configuration → App settings → Verification key (the full PEM, including BEGIN/END lines)
PRIVY_VERIFICATION_KEY=
# Take builder
OPENAI_API_KEY=
# Model for basket picks + catalog descriptions (reasoning off, priority tier). Default gpt-6-luna
OPENAI_FAST_MODEL=gpt-6-luna
# Optional: the take builder's whole model exchange per basket, in ms (default 8000)
TAKE_AGENT_TIMEOUT_MS=
# Random secret for the admin-only securities-index function (openssl rand -hex 32)
SECURITIES_INDEX_SECRET=
# Optional: a free CoinGecko demo API key for asset price history (functions/assets). Without it the
# keyless GeckoTerminal API is used, which is often rate limited from edge functions' shared IPs.
COINGECKO_API_KEY=

# QuickNode Stream webhook (functions/quicknode-stream): the Stream's security token. The fork relay
# signs with the same value (THESIS_WEBHOOK_TOKEN in the repo-root .env). openssl rand -hex 32
QUICKNODE_STREAM_TOKEN=
# Backend → inbox (functions/notify): the daily positions digest is signed with this. The fork API
# signs with the same value (NOTIFY_TOKEN in the repo-root .env). openssl rand -hex 32
NOTIFY_TOKEN=
# Gemini proxy (functions/gemini): callers send it as x-gemini-proxy-token. The backend uses the same
# value (GEMINI_PROXY_TOKEN in the repo-root .env). openssl rand -hex 32
GEMINI_PROXY_TOKEN=

# Optional (functions/take-builder, functions/assets): "on" hides what US persons can't buy (xStocks,
# Phoenix perps…) from accounts in the US or with no country. Off by default: everyone gets the whole
# catalog until geoblocking is decided.
US_RESTRICTIONS=

# Optional (functions/social): "on" lets a client post a take live at once, without the chain (only
# for a project that serves non-fork builds alone). Off by default: every take is created posting,
# seen by its author only, until its on-chain buy-in's takeCreated event makes it live.
TAKES_LIVE_WITHOUT_CHAIN=

# Web push (functions/web-push): the VAPID key pair (the public key is also built into apps/www) and
# the contact URL push services see. Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Executor → Supabase (functions/marks, functions/price-audit): shared secrets the marker and the
# settler send. Same values as MARKS_TOKEN / PRICE_AUDIT_TOKEN in the executor's env. openssl rand -hex 32
MARKS_TOKEN=
PRICE_AUDIT_TOKEN=

# functions/source: X posts (copied accounts, the X bot). Each falls back to the Vault secret of the
# same name in lowercase (apify_token, x_poll_secret, bot_secret) when unset here.
# Apify API token for reading copied accounts' posts (Apify console → Settings → Integrations)
APIFY_TOKEN=
# The pg_cron poll's x-poll-secret header (the x-poll job reads the Vault's x_poll_secret). openssl rand -hex 32
X_POLL_SECRET=
# The chat bots' x-bot-secret header for POST /source/drafts. openssl rand -hex 32
BOT_SECRET=

# agent (trading by text and the X bot's score): Privy's session signer (its authorization key,
# "wallet-auth:…", and its id), optional policy ids, the fork API and its "agent" service key, the
# web app, the chain whose scores the reads answer, and wallets whose limits may pass $1,000.
PRIVY_AUTHORIZATION_KEY=
PRIVY_SIGNER_ID=
PRIVY_SIGNER_POLICY_IDS=
FORK_API_URL=https://<fork-host>
FORK_API_SERVICE_KEY=
WEB_URL=https://yourthesis.xyz
CHAIN_NETWORK=solana-mainnet-fork
AGENT_LIMIT_OVERRIDES=
