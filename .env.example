# Public client config (safe to ship in the iOS app)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PRIVY_APP_ID=
PRIVY_CLIENT_ID=

# --- Environments -----------------------------------------------------------
# Today there is ONE backend. Both iOS builds point at it:
#   dev  build  xyz.yourthesis.app.dev  (scheme yourthesis-dev)  -> Supabase `thesis` + same Privy app
#   prod build  xyz.yourthesis.app      (scheme yourthesis)      -> Supabase `thesis` + same Privy app
# So dev signups/test data land in the same DB as real users; wipe test rows before demos.
# Solana is mainnet for both (venues are mainnet-only; small real amounts).
#
# Not a real stg/prod split yet. Deferred because:
#   - Supabase free tier is capped at 2 active projects (branching needs Pro)
#   - a devnet staging can't exercise Jupiter / xStocks / Phoenix / Gemini
#
# To split later: create Supabase `thesis-staging` + a second Privy app, then move the
# iOS backend values in apps/ios/Config/Backend.local.xcconfig into a Debug-only file with the staging
# values. No code changes needed.

# Fork relay → Supabase webhook (pnpm fork:relay): the deployed function and the same secret as its
# QUICKNODE_STREAM_TOKEN. Without THESIS_WEBHOOK_URL the relay just prints payloads.
THESIS_WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/quicknode-stream
THESIS_WEBHOOK_TOKEN=

# Daily positions digest (pnpm fork:api posts it once a day after 9 am New York time (override with DIGEST_HOUR_UTC)):
# the notify function and the same secret as its NOTIFY_TOKEN. Without them it only logs.
NOTIFY_URL=https://<project-ref>.supabase.co/functions/v1/notify
NOTIFY_TOKEN=

# Gemini prediction-market data (packages/venues/gemini): always read through the Supabase `gemini`
# function, so Gemini never sees this machine's address. The same secret as its GEMINI_PROXY_TOKEN.
# GEMINI_PROXY_URL defaults to <SUPABASE_URL>/functions/v1/gemini.
GEMINI_PROXY_TOKEN=
