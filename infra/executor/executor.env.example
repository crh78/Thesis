# /etc/thesis/executor.env: root only (0600 root:root). systemd reads it for each Thesis service;
# the services themselves can't open it. Same names as the repo-root .env.

# Mainnet RPC the fork reads through (thesis-surfpool). Empty: public mainnet, which rate-limits
# heavy use. Today: the owner's QuickNode Build URL (not the free plan, which caps
# getMultipleAccounts at 5; README, "Mainnet RPC for the fork"). It carries the provider's key: the unit
# hands it to Surfpool as SURFPOOL_DATASOURCE_RPC_URL, never on a command line.
FORK_DATASOURCE_RPC_URL=

# Settler and marker prices. JUPITER_API_KEY is required (api.jup.ag; the keyless lite-api is
# being retired); the settler, marker, asset bank and fork API share its per-account limit.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
JUPITER_API_KEY=
# Optional: a separate Jupiter key for the fork API's trades (builds, sales, sweeps). Then
# JUPITER_API_KEY serves only the settler, marker and asset bank. Unset on the VM: JUPITER_API_KEY is
# on the owner's Developer plan (10 a second for the whole organisation), shared by everything.
JUPITER_TRADE_API_KEY=
# The fork API's Jupiter budget, a minute (default 30, sized for a free key). The VM: 420 of the
# Developer plan's 600, with FORK_API_JUPITER_BURST=10 (at most ~80 per 10 s, under Jupiter's 100).
FORK_API_JUPITER_RPM=
# Requests at once (default 10). Jupiter's free tier is about one a second; smaller is slower to build.
FORK_API_JUPITER_BURST=
# Optional ccsk_ key for card legs' insured values (higher Collector Crypt rate limits).
COLLECTOR_CRYPT_API_KEY=
# Publishes each signed price's source document to public.price_audit (the price-audit function's
# secret). Empty: the settler keeps them in its local audit file only.
PRICE_AUDIT_TOKEN=

# Marker (thesis-marker): writes live returns through the marks function (its secret).
MARKS_TOKEN=

# Asset-bank poller: syncs the catalog's tradeable flags every 15 minutes through the
# securities-index function (its secret). Empty: no sync.
SECURITIES_INDEX_SECRET=

# Asset-bank poller (thesis-asset-bank): mainnet reads for token discovery, and Pyth if you have a key.
QUICKNODE_RPC_URL=
PYTH_API_KEY=
# Asset-bank poller: liquidity probes route only through the fork router's venues, so the
# take builder never offers a token the fork can't buy. Keep it equal to FORK_DEXES in
# scripts/fork/lib.ts (a test checks this line). Empty: every venue (mainnet).
ASSET_BANK_DEXES=Whirlpool,Raydium,Raydium CLMM,Raydium CP,Meteora,Meteora DLMM,Meteora DAMM v2,PancakeSwap,Orca V2,OpenBook V2,Phoenix,Stabble Stable Swap,Saber

# Supabase: the settler's open positions (chain_positions), the fork API's takes. The
# service-role key only with ASSET_BANK_SINK=supabase (the bank in Supabase instead of a file).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# ASSET_BANK_SINK=supabase
# SUPABASE_SERVICE_ROLE_KEY=

# The fork API's daily positions digest (supabase/functions/notify)
NOTIFY_URL=
NOTIFY_TOKEN=

# Gemini, always through the Supabase proxy
GEMINI_PROXY_URL=
GEMINI_PROXY_TOKEN=

# The fork Blink's public origin, the Funnel URL on port 8443 (README, "Setting it up"), e.g.
# https://<fork-host>:8443. The Blink is closed: FORK_BLINK_PORT= (empty) keeps its listener off.
FORK_BLINK_ORIGIN=
FORK_BLINK_PORT=

# The fork API's abuse limits (scripts/fork/README.md, "Abuse limits"). The live fork enforces
# both. Unset, they fall back to report mode (log and serve), so a rebuilt VM must set them.
#   FORK_API_AUTH         report (default) | enforce | off. enforce: money routes need a Privy
#                         access token for the wallet, or a service key; needs the PRIVY_* below.
#   FORK_API_READ_LIMIT   report (default) | enforce: 120 reads a minute per Privy user when a
#                         token is present, else per IP. enforce needs FORK_API_PROXY_KEY, here and
#                         in the web app's Vercel settings, or every signed-out visitor behind the
#                         proxy shares one IP's budget.
FORK_API_AUTH=enforce
FORK_API_READ_LIMIT=enforce
# Servers that act for any wallet (the X agent): name=secret,name=secret (16+ characters each).
FORK_API_SERVICE_KEYS=
# Shared with the web app's Vercel proxy, which sends it with the visitor's IP.
FORK_API_PROXY_KEY=
# Origins whose browsers may call the fork API directly (CORS), comma-separated, each just
# scheme://host[:port], e.g. https://yourthesis.xyz. Unset: no CORS headers (proxy only).
FORK_API_CORS_ORIGINS=
# The Thesis Privy app, the same values as the Supabase `session` function: verifies access
# tokens and looks up each user's embedded wallet.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# Fake USDC per wallet, ever (default 1000; 0 for no cap).
# FORK_DEPOSIT_CAP_USD=1000

# Fork relay -> the quicknode-stream webhook
THESIS_WEBHOOK_URL=
THESIS_WEBHOOK_TOKEN=
THESIS_WEBHOOK_AUTH=
# The last transaction the relay delivered, for its back-fill on start (default below).
# FORK_RELAY_STATE=/opt/thesis/.data/fork/relay-state.json

# Mainnet: the settler key's secret in OCI Vault (README, "Settler key in OCI Vault"). Unused
# until the vault drop-in is installed.
# OCI_SETTLER_SECRET_OCID=ocid1.vaultsecret.oc1....
