# The app's fork API on 127.0.0.1:18901 and the fork Blink on 127.0.0.1:18902 (closed: its
# listener is off). Caddy publishes the API over HTTPS (infra/executor/caddy); Tailscale Funnel,
# which used to publish both, is off. FORK_BLINK_ORIGIN, the Blink's public origin, comes from
# /etc/thesis/executor.env.
[Unit]
Description=Thesis: fork API
After=thesis-fork-up.service
Requires=thesis-fork-up.service

[Service]
User=thesis
WorkingDirectory=/opt/thesis
EnvironmentFile=/etc/thesis/executor.env
Environment=FORK_HOST=127.0.0.1 FORK_API_PORT=18901 FORK_BLINK_PORT=18902
# Node directly (`pnpm fork:api` runs the same file), without the pnpm wrapper.
ExecStart=/usr/bin/node scripts/fork/api.ts
Restart=always
RestartSec=5
# Public through Caddy: it writes only under .data, can't gain privileges, and sees no home
# directories (infra/executor/README.md, "Hardening").
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/thesis/.data
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
