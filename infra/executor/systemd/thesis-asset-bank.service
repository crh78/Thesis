# The asset-bank poller. Jupiter's free key allows about 60 requests a minute; 25 leaves room for
# the settler and the fork API, which use the same key. Gemini goes through the Supabase proxy.
[Unit]
Description=Thesis: asset-bank poller
After=network-online.target
Wants=network-online.target

[Service]
User=thesis
WorkingDirectory=/opt/thesis
EnvironmentFile=/etc/thesis/executor.env
Environment=ASSET_BANK_JUPITER_RPM=25
# Node directly (`pnpm --filter @thesis/executor asset-bank` runs the same file): no ~135 MB pnpm
# wrapper. On SIGTERM it flushes the bank and exits within about 10 s.
ExecStart=/usr/bin/node apps/executor/src/asset-bank.ts
Restart=always
RestartSec=30
TimeoutStopSec=30
# Writes only under .data (infra/executor/README.md, "Hardening").
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/thesis/.data
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
