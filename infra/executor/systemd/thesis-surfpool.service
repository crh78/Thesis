# The mainnet fork: Surfpool's linux/arm64 image (tested on aarch64, 1.7.0). RPC and websocket
# listen on 127.0.0.1 only; nothing outside the VM reaches them.
[Unit]
Description=Thesis: Surfpool mainnet fork
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f thesis-surfpool
# Forks from FORK_DATASOURCE_RPC_URL in the env file when it's set (a Helius or Alchemy URL:
# public mainnet rate-limits heavy use), else public mainnet.
#
# The URL carries the provider's API key, so it never goes on a command line (where `ps` and the
# journal would show it): Surfpool 1.7.0 reads SURFPOOL_DATASOURCE_RPC_URL instead of --rpc-url,
# and `docker run -e NAME` passes it from this environment without its value. Only root can see
# it (the env file, `docker inspect`); the `thesis` user isn't in the docker group.
EnvironmentFile=-/etc/thesis/executor.env
ExecStart=/bin/sh -c 'if [ -n "$$FORK_DATASOURCE_RPC_URL" ]; then export SURFPOOL_DATASOURCE_RPC_URL="$$FORK_DATASOURCE_RPC_URL"; src="-e SURFPOOL_DATASOURCE_RPC_URL"; net=""; else src=""; net="--network mainnet"; fi; \
  exec /usr/bin/docker run --name thesis-surfpool --rm $$src \
  -p 127.0.0.1:18899:8899 -p 127.0.0.1:18900:8900 \
  surfpool/surfpool:1.7.0 \
  start $$net --host 0.0.0.0 --port 8899 --ws-port 8900 --no-tui --no-deploy --airdrop-amount 0'
# In case Surfpool echoes its datasource: drop any log line carrying a key (systemd 253+).
LogFilterPatterns=~api-key=
ExecStop=/usr/bin/docker stop thesis-surfpool

[Install]
WantedBy=multi-user.target
