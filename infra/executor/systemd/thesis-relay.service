# Stands in for the QuickNode Stream on the fork: delivers Thesis transactions to the Supabase
# webhook (THESIS_WEBHOOK_URL / _TOKEN / _AUTH in the env file). Not needed on mainnet, where the
# Stream does this.
[Unit]
Description=Thesis: fork Stream relay
After=thesis-fork-up.service
Requires=thesis-fork-up.service

[Service]
User=thesis
WorkingDirectory=/opt/thesis
EnvironmentFile=/etc/thesis/executor.env
Environment=FORK_RPC_URL=http://127.0.0.1:18899 FORK_WS_URL=ws://127.0.0.1:18900
# Node directly (`pnpm fork:relay` runs the same file), without the pnpm wrapper. It keeps the last
# transaction it delivered in .data/fork/relay-state.json and back-fills from it on start.
ExecStart=/usr/bin/node infra/quicknode/fork-relay.ts
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/thesis/.data
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
